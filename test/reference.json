[{"text": "Her breath hitches.", "ids": [101, 2014, 3052, 27738, 2229, 1012, 102], "offsets": [[0, 0], [0, 3], [4, 10], [11, 16], [16, 18], [18, 19], [0, 0]], "probs": [0.99841, 0.99924, 0.99924, 0.99924, 0.99922, 0.00064, 0.99747]}, {"text": "He sets the cup down, jaw tight.", "ids": [101, 2002, 4520, 1996, 2452, 2091, 1010, 5730, 4389, 1012, 102], "offsets": [[0, 0], [0, 2], [3, 7], [8, 11], [12, 15], [16, 20], [20, 21], [22, 25], [26, 31], [31, 32], [0, 0]], "probs": [0.00192, 0.00068, 0.00796, 0.00059, 0.00053, 0.00087, 0.60634, 0.77582, 0.82869, 0.00051, 0.00361]}, {"text": "She crosses the room and stays there, chest heaving.", "ids": [101, 2016, 7821, 1996, 2282, 1998, 12237, 2045, 1010, 3108, 23907, 1012, 102], "offsets": [[0, 0], [0, 3], [4, 11], [12, 15], [16, 20], [21, 24], [25, 30], [31, 36], [36, 37], [38, 43], [44, 51], [51, 52], [0, 0]], "probs": [0.89502, 0.03151, 0.09205, 0.032, 0.03651, 0.96749, 0.99413, 0.99731, 0.99692, 0.99818, 0.9988, 0.00054, 0.74312]}, {"text": "He sets the cup down and opens the window.", "ids": [101, 2002, 4520, 1996, 2452, 2091, 1998, 7480, 1996, 3332, 1012, 102], "offsets": [[0, 0], [0, 2], [3, 7], [8, 11], [12, 15], [16, 20], [21, 24], [25, 30], [31, 34], [35, 41], [41, 42], [0, 0]], "probs": [0.00068, 0.00052, 0.00051, 0.00048, 0.00048, 0.00049, 0.00079, 0.00077, 0.00067, 0.00064, 0.0005, 0.00099]}, {"text": "She ties off the bandage, watching your hands.", "ids": [101, 2016, 7208, 2125, 1996, 24446, 1010, 3666, 2115, 2398, 1012, 102], "offsets": [[0, 0], [0, 3], [4, 8], [9, 12], [13, 16], [17, 24], [24, 25], [26, 34], [35, 39], [40, 45], [45, 46], [0, 0]], "probs": [0.00141, 0.00068, 0.00075, 0.0007, 0.00069, 0.00075, 0.00957, 0.02027, 0.00285, 0.00477, 0.00052, 0.00183]}, {"text": "He lets out a breath he didn't know he was holding.", "ids": [101, 2002, 11082, 2041, 1037, 3052, 2002, 2134, 1005, 1056, 2113, 2002, 2001, 3173, 1012, 102], "offsets": [[0, 0], [0, 2], [3, 7], [8, 11], [12, 13], [14, 20], [21, 23], [24, 28], [28, 29], [29, 30], [31, 35], [36, 38], [39, 42], [43, 50], [50, 51], [0, 0]], "probs": [0.99007, 0.99699, 0.99801, 0.99826, 0.99818, 0.99789, 0.99743, 0.9962, 0.99704, 0.99652, 0.99329, 0.99518, 0.99361, 0.99539, 0.00051, 0.99393]}, {"text": "\"Come up, or send me away.\"", "ids": [101, 1000, 2272, 2039, 1010, 2030, 4604, 2033, 2185, 1012, 1000, 102], "offsets": [[0, 0], [0, 1], [1, 5], [6, 8], [8, 9], [10, 12], [13, 17], [18, 20], [21, 25], [25, 26], [26, 27], [0, 0]], "probs": [0.8779, 0.12437, 0.97846, 0.98, 0.9892, 0.99383, 0.99088, 0.99027, 0.98871, 0.00078, 0.0008, 0.96434]}, {"text": "A smirk plays on his lips.", "ids": [101, 1037, 15081, 3248, 2006, 2010, 2970, 1012, 102], "offsets": [[0, 0], [0, 1], [2, 7], [8, 13], [14, 16], [17, 20], [21, 25], [25, 26], [0, 0]], "probs": [0.99658, 0.99897, 0.99898, 0.99899, 0.99896, 0.99888, 0.99889, 0.00055, 0.99756]}, {"text": "Her fingers rest on your neck, not squeezing, just there.", "ids": [101, 2014, 3093, 2717, 2006, 2115, 3300, 1010, 2025, 15328, 1010, 2074, 2045, 1012, 102], "offsets": [[0, 0], [0, 3], [4, 11], [12, 16], [17, 19], [20, 24], [25, 29], [29, 30], [31, 34], [35, 44], [44, 45], [46, 50], [51, 56], [56, 57], [0, 0]], "probs": [0.01788, 0.00249, 0.00161, 0.00232, 0.00267, 0.00165, 0.00208, 0.98186, 0.99792, 0.99802, 0.99742, 0.99863, 0.99851, 0.0005, 0.4387]}, {"text": "He knows the bar is shut, and he knocks anyway.", "ids": [101, 2002, 4282, 1996, 3347, 2003, 3844, 1010, 1998, 2002, 21145, 4312, 1012, 102], "offsets": [[0, 0], [0, 2], [3, 8], [9, 12], [13, 16], [17, 19], [20, 24], [24, 25], [26, 29], [30, 32], [33, 39], [40, 46], [46, 47], [0, 0]], "probs": [0.13133, 0.03004, 0.03321, 0.0434, 0.03469, 0.03529, 0.04327, 0.71391, 0.9097, 0.92409, 0.80499, 0.97961, 0.00053, 0.20026]}, {"text": "The rain has stopped by the time you reach the car.", "ids": [101, 1996, 4542, 2038, 3030, 2011, 1996, 2051, 2017, 3362, 1996, 2482, 1012, 102], "offsets": [[0, 0], [0, 3], [4, 8], [9, 12], [13, 20], [21, 23]